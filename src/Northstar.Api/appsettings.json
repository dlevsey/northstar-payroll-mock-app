{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Northstar": "Data Source=northstar.db"
  },
  "SeedData": true,
  "PayrollProvider": {
    "BaseUrl": "http://localhost:5130",
    "MaxAttempts": 3,
    "BaseRetryDelayMilliseconds": 100,
    "AttemptTimeoutMilliseconds": 10000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
