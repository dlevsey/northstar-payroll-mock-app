@host = http://localhost:5120
@organizationA = 11111111-1111-1111-1111-111111111111
@runA = aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaa1001
@batch = replace-with-import-batch-id

GET {{host}}/health

### List the current tenant's runs
GET {{host}}/api/payroll-runs
X-Organization-Id: {{organizationA}}
X-User-Role: PayrollManager

### Calculate the seeded run
POST {{host}}/api/payroll-runs/{{runA}}/calculate
X-Organization-Id: {{organizationA}}
X-User-Role: PayrollManager
Idempotency-Key: demo-calculate-1
Content-Type: application/json

{}

### Reusing a key with a different operation payload returns 409
POST {{host}}/api/payroll-runs/{{runA}}/approve
X-Organization-Id: {{organizationA}}
X-User-Role: PayrollManager
Content-Type: application/json

{
  "expectedVersion": 2
}

### Queue a mixed provider import (returns 202 + Location)
POST {{host}}/api/import-batches
X-Organization-Id: {{organizationA}}
X-User-Role: PayrollManager
Idempotency-Key: demo-import-mixed-1
Content-Type: application/json

{
  "periodStart": "2026-08-24",
  "periodEnd": "2026-08-30",
  "providerScenario": "mixed"
}

### Poll status and inspect rejected/duplicate rows
GET {{host}}/api/import-batches/{{batch}}
X-Organization-Id: {{organizationA}}
X-User-Role: PayrollManager

GET {{host}}/api/import-batches/{{batch}}/errors
X-Organization-Id: {{organizationA}}
X-User-Role: PayrollManager

### Retry a transient terminal failure idempotently
POST {{host}}/api/import-batches/{{batch}}/retry
X-Organization-Id: {{organizationA}}
X-User-Role: PayrollManager
Idempotency-Key: demo-import-retry-1
Content-Type: application/json

{}
